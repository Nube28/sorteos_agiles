generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Numero {
  id            String      @id @default(uuid())
  posicion      Int
  fechaApartado DateTime

  sorteoId String
  sorteo   Sorteo @relation(fields: [sorteoId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  pagosId String?
  Pagos   Pagos? @relation(fields: [pagosId], references: [id])

  // Cada posición en un sorteo debe ser única
  @@unique([sorteoId, posicion])
}

model Sorteo {
  id                 String      @id @default(uuid())
  nombre             String
  urlImg             String?
  descripcion        String
  premio             String
  cantidadNumeros    Int
  periodoInicioVenta DateTime
  periodoFinVenta    DateTime
  costo              Float
  fechaSorteo        DateTime
  tiempoLimitePago   Int

  organizadorId String
  organizador   Organizador @relation(fields: [organizadorId], references: [id])
  Numero        Numero[]
}

model Usuario {
  id            String    @id @default(uuid())
  nombre        String
  // cambiar de opcional a obligatorio 
  contrasenia   String
  nombreUsuario String @unique
  apellidos     String
  rol           Rol

  Organizador Organizador?
  Cliente     Cliente?
}

enum Rol {
  ORGANIZADOR
  CLIENTE
}

model Organizador {
  id String @id @default(uuid())

  usuarioId String     @unique
  user      Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  sorteos Sorteo[]
}

model Cliente {
  id String @id @default(uuid())

  usuarioId String     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  numeros Numero[]
  pagos   Pagos[]
}

model Pagos {
  id String @id @default(uuid())

  usuarioId String
  usuario   Cliente @relation(fields: [usuarioId], references: [id])

  urlComprobante String
  numerosPagados Numero[]
}
